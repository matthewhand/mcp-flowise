# Copy this file to .env and fill in the values you need. Never commit .env.

# --- General -----------------------------------------------------------------

# Flowise base URL. Must start with http:// or https:// and contain no query string.
FLOWISE_API_ENDPOINT=http://localhost:3000

# Bearer token. Optional for a local, unauthenticated Flowise. Never logged.
FLOWISE_API_KEY=

# Per-request timeout in seconds (0 < t <= 600).
FLOWISE_API_TIMEOUT=30

# DEBUG=true adds debug records to stderr (stdout stays reserved for MCP).
DEBUG=false

# --- Mode ---------------------------------------------------------------------

# simple (default): list_chatflows + create_prediction, no start-up discovery.
# lowlevel: one tool per allowed chatflow, discovered at start-up and refreshed
#           on every tools/list.
# FLOWISE_MODE=simple
# FLOWISE_SIMPLE_MODE=true

# --- Targets (simple mode) ----------------------------------------------------

# Default chatflow for create_prediction. Only one of these may be set.
FLOWISE_CHATFLOW_ID=

# NOT IMPLEMENTED: setting this stops the server with a configuration error.
FLOWISE_ASSISTANT_ID=

# --- Descriptions (lowlevel mode) ---------------------------------------------

# Comma-separated "id:description" pairs used as tool descriptions.
# FLOWISE_CHATFLOW_DESCRIPTIONS=chatflow_id:My "First" Chatflow,another_id:My Second Chatflow

# --- Filtering (both modes) ---------------------------------------------------

# If ANY whitelist rule is set, only chatflows matching a whitelist rule are
# exposed (blacklists are then irrelevant). Otherwise the blacklists apply.
# The same policy is enforced when a tool is dispatched, not only when the
# catalog is built.

# FLOWISE_WHITELIST_ID=id1,id2
# FLOWISE_BLACKLIST_ID=id3
# FLOWISE_WHITELIST_NAME_REGEX=.*important.*
# FLOWISE_BLACKLIST_NAME_REGEX=.*deprecated.*

# Legacy names from older FastMCP-only builds. They are honoured ONLY when the
# matching variable above is unset; they are never merged into it.
# FLOWISE_CHATFLOW_WHITELIST=
# FLOWISE_CHATFLOW_BLACKLIST=
