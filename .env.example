# Copy to .env, supply your private key, and never commit the resulting file.
FLOWISE_API_ENDPOINT=http://localhost:3000
FLOWISE_API_KEY=
FLOWISE_SIMPLE_MODE=true
FLOWISE_HTTP_TIMEOUT=30
FLOWISE_CHATFLOW_ID=
# Assistant IDs are unsupported; use a chatflow ID.
FLOWISE_CHATFLOW_DESCRIPTIONS=
# Both modes enforce these filters during discovery and prediction.
# Whitelist ID/name rules combine with OR and override the primary blacklist.
FLOWISE_WHITELIST_ID=
FLOWISE_BLACKLIST_ID=
FLOWISE_WHITELIST_NAME_REGEX=
FLOWISE_BLACKLIST_NAME_REGEX=
# Legacy lists add restrictions to the canonical policy.
FLOWISE_CHATFLOW_WHITELIST=
FLOWISE_CHATFLOW_BLACKLIST=
MCP_SERVER_NAME=mcp-flowise
TOOL_NAME_PREFIX=
TOOL_NAME_MAX_LENGTH=64
DEBUG=false
# Optional rotating file; otherwise diagnostics use stderr.
FLOWISE_LOGFILE_PATH=
